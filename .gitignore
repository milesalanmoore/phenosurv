# --- Operating system clutter ---------------------------------------------------
# Patterns without a slash match at any depth, so these apply everywhere.
.DS_Store
._*
.AppleDouble
.LSOverride
Icon?
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.directory

# --- Editors and IDEs ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.*.sw?
*.sublime-workspace
.positron/

# --- Environments ----------------------------------------------------------------
.pixi/
.venv/
venv/
env/
.conda/

# --- Secrets and local config ----------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ----------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.whl
.ipynb_checkpoints/

# --- Test, coverage and lint caches ----------------------------------------------
.coverage
.coverage.*
htmlcov/
coverage.xml
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# --- R (ecologists often have RStudio open in the same folder) ------------------
.Rhistory
.RData
.Rproj.user/

# --- CmdStan build and sampling output -------------------------------------------
# Compiled model executables have no extension on macOS/Linux, so add a rule for
# the directory the packaged .stan files end up in once it exists.
*.hpp
*.o
*.exe
